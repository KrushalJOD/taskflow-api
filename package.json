{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "TaskFlow API - a small full-stack task management REST API built for the SIT223/SIT753 7.3HD Jenkins DevOps pipeline task.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "test": "jest --ci --runInBand --reporters=default --reporters=jest-junit --coverage",
    "lint": "eslint src --ext .js -f json -o eslint-report.json || true",
    "lint:console": "eslint src --ext .js"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov",
      "text",
      "cobertura"
    ]
  },
  "jest-junit": {
    "outputDirectory": "test-results",
    "outputName": "junit.xml"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18"
  }
}
